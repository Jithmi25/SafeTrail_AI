rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validSafetyReport(data) {
      return data.userId is string
        && data.userId == request.auth.uid
        && data.category in [
          'unsafe_area',
          'scam',
          'bad_lighting',
          'suspicious_activity',
          'safe_area'
        ]
        && data.severity in ['safe', 'low', 'moderate', 'high', 'critical']
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.createdAt == request.time;
    }

    function validSosIncident(data) {
      return data.userId is string
        && data.userId == request.auth.uid
        && data.status in ['triggered', 'acknowledged', 'resolved', 'cancelled']
        && (data.latitude is number || data.latitude == null)
        && (data.longitude is number || data.longitude == null)
        && data.contactsNotified is number
        && data.createdAt == request.time;
    }

    // A profile is stored at profiles/{userId} and can only be accessed by its owner.
    match /profiles/{userId} {
      allow read, create, update: if isOwner(userId);

      match /chatMessages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.createdAt == request.time
          && request.resource.data.role in ['user', 'assistant'];
        allow update, delete: if false;
      }
    }

    match /safetyReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn() && validSafetyReport(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.category in [
          'unsafe_area',
          'scam',
          'bad_lighting',
          'suspicious_activity',
          'safe_area'
        ]
        && request.resource.data.severity in [
          'safe',
          'low',
          'moderate',
          'high',
          'critical'
        ]
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /sosIncidents/{incidentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validSosIncident(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status in ['triggered', 'acknowledged', 'resolved', 'cancelled'];
    }

    // Public reference content is read-only from the client. It is seeded by a
    // trusted deployment/admin process, never by an end-user app session.
    match /scamEntries/{entryId} {
      allow read: if signedIn();
    }

    match /serviceProviders/{providerId} {
      allow read: if signedIn();
    }

    match /safetyZones/{zoneId} {
      allow read: if signedIn();
    }

    match /mapMarkers/{markerId} {
      allow read: if signedIn();
    }

    match /safeRoutes/{routeId} {
      allow read: if signedIn();
    }

    // Deny every collection that is not explicitly defined above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}